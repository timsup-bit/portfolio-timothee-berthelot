---
import "../styles/global.css";

const siteUrl = "https://colletdigital.com";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL("/apple-touch-icon.png", siteUrl).toString();
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>Timothée Berthelot - Développeur iOS & Étudiant BTS SIO</title>
<meta
  name="description"
  content="Portfolio de Timothée Berthelot, étudiant en BTS SIO SLAM spécialisé en développement iOS. Passionné de cybersécurité et futur pentester."
/>
<meta name="keywords" content="développeur iOS, Swift, BTS SIO, cybersécurité, pentester, développeur mobile, Montreuil, portfolio" />
<meta name="author" content="Timothée Berthelot" />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

<!-- Favicons for different sizes -->
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content="Timothée Berthelot - Développeur iOS & Étudiant BTS SIO" />
<meta
  property="og:description"
  content="Portfolio de Timothée Berthelot, étudiant en BTS SIO SLAM spécialisé en développement iOS. Passionné de cybersécurité et futur pentester."
/>
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="fr_FR" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content="Timothée Berthelot - Développeur iOS & Étudiant BTS SIO" />
<meta
  property="twitter:description"
  content="Portfolio de Timothée Berthelot, étudiant en BTS SIO SLAM spécialisé en développement iOS. Passionné de cybersécurité et futur pentester."
/>
<meta property="twitter:image" content={ogImage} />

<!-- Canonical URL -->
<link rel="canonical" href={canonical} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Apple Touch Icon (already included in favicons, but keeping for backwards compatibility) -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#0000ff" />

<!-- For IE -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
 <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" /> 

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
