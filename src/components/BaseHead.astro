---
import "../styles/global.css";

const siteUrl = "https://www.colletdigital.com";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL("/favicons/android-chrome-512x512.png", siteUrl).toString();

const title = "Timothée Collet Berthelot — Développeur, spécialisation cybersécurité";
const description = "Portfolio de Timothée Collet Berthelot, développeur logiciel en spécialisation cybersécurité à Epitech. Applications iOS natives, web full-stack, systèmes et réseaux. Recherche une alternance en cybersécurité.";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="Timothée Collet Berthelot, développeur, cybersécurité, alternance cybersécurité, Swift, iOS, React, Node.js, Linux, systèmes et réseaux, Epitech, BTS SIO SLAM, Montreuil, portfolio" />
<meta name="author" content="Timothée Collet Berthelot" />

<!-- Favicons — les fichiers vivent dans /public/favicons -->
<link rel="icon" href="/favicons/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/favicons/site.webmanifest" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="fr_FR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />

<!-- La couleur de barre suit le theme du visiteur -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f5ef" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131311" />

<!-- Le thème est décidé avant la première peinture : sinon le navigateur
     affiche d'abord la préférence système, puis bascule quand le script de
     fin de page s'exécute — un flash de mauvais thème. -->
<script is:inline>
  (function () {
    var r = document.documentElement, choix = null;
    try {
      var v = localStorage.getItem("tb-theme");
      if (v === "dark" || v === "light") choix = v;
    } catch (e) {}
    if (!choix) {
      var h = new Date().getHours();
      choix = (h >= 6 && h < 18) ? "light" : "dark";
    }
    r.dataset.theme = choix;
    r.lang = "fr";
  })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@300..600&display=swap"
/>
