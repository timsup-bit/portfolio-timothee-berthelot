---
const skills = [
  {
    category: "Développement Mobile",
    technologies: "Swift, SwiftUI, UIKit, Xcode",
    description:
      "Création d'applications iOS natives avec une attention particulière à l'expérience utilisateur et aux performances. Maîtrise du cycle de vie iOS et des design patterns modernes.",
  },
  {
    category: "Développement Web & Backend",
    technologies: "HTML, CSS, JavaScript, PHP, Python",
    description:
      "Développement d'applications web full-stack et d'API REST. Compétences acquises en BTS SIO SLAM pour créer des solutions complètes et évolutives.",
  },
  {
    category: "Bases de Données",
    technologies: "SQL, MySQL, PostgreSQL, Modélisation",
    description:
      "Conception et gestion de bases de données relationnelles. Optimisation des requêtes et mise en place d'architectures de données robustes pour des applications performantes.",
  },
  {
    category: "Outils & Méthodologie",
    technologies: "Git, GitHub, Agile, VS Code, Docker",
    description:
      "Maîtrise des outils de versionning et des méthodologies agiles. Expérience en travail collaboratif et déploiement d'applications. Préparation pour un Bachelor en cybersécurité en 2026.",
  },
];
// Function to calculate `data-aos-duration` based on index
function calculateAosDuration(index) {
  return 1500 + index * 500; // Example: Increment duration by 500ms for each project
}
---

<section class="bg-primary">
  <div class="px-8 2xl:max-w-7xl mx-auto py-6">
    <div class="mt-6 space-y-2">
      <div class="h-0.5 bg-secondary"></div>
      <h3 class="text-secondary text-base font-medium">
        <span>mes</span>
        <span class="font-bold">compétences</span>
      </h3>
    </div>
    <div class="flex flex-col text-secondary pt-2 mt-2 gap-12 lg:gap-32">
      {
        skills.map((skill, index) => (
          <div
            data-aos="fade-up"
            data-aos-duration={calculateAosDuration(index)}
            class="grid grid-cols-1 lg:items-end lg:grid-cols-4 py-4 gap-4"
          >
            <p class="text-3xl  lg:col-span-3 lg:text-5xl  indent-32 lg:indent-32">
              {skill.description}
            </p>
            <div class="block">
              <p class="font-bold text-base mb-2">
                {skill.category}
              </p>
              <p class="italic text-xs">
                {skill.technologies}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
