---
// Define the features array directly in the Astro component
const features = [
  {
    "url": "#",
    "title": "BTS SIO SLAM (2024-2026)"
  },
  {
    "url": "#",
    "title": "Certification PIX (Envisagée)"
  },
  {
    "url": "#",
    "title": "Apple Developer Certificate (En cours)"
  },
  {
    "url": "#",
    "title": "Certification SQL (Envisagée)"
  },
  {
    "url": "#",
    "title": "Bachelor Cybersécurité (2026)"
  },
  {
    "url": "#",
    "title": "CISCO CCNA (Envisagée)"
  },
  {
    "url": "#",
    "title": "CompTIA Security+ (Envisagée)"
  },
  {
    "url": "#",
    "title": "CEH - Certified Ethical Hacker (Objectif)"
  },
  {
    "url": "https://github.com/timsup-bit",
    "title": "Projets Open Source GitHub"
  },
  {
    "url": "#",
    "title": "Stages en Entreprise BTS"
  }
];
---

<section class="bg-primary">
  <div class="px-8 2xl:max-w-7xl mx-auto py-6">
    <div class="mt-32 space-y-2">
      <div
        class="h-0.5 bg-secondary"
        data-aos="fade-up"
        data-aos-duration="1000">
      </div>
      <h3
        class="text-secondary text-xs font-medium"
        data-aos="fade-up"
        data-aos-duration="1500">
        <span>Formations &</span>
        <span class="font-bold">certifications</span>
        <span class="italic">actuelles & envisagées</span>
      </h3>
      <div
        class="h-1.5 bg-secondary"
        data-aos="fade-up"
        data-aos-duration="2000">
      </div>
      <div class="h-3 bg-secondary" data-aos="fade-up" data-aos-duration="2500">
      </div>
      <div class="h-6 bg-secondary" data-aos="fade-up" data-aos-duration="3000">
      </div>
      <div
        class="h-12 bg-secondary"
        data-aos="fade-up"
        data-aos-duration="3000">
      </div>
      <div
        class="h-24 bg-secondary"
        data-aos="fade-up"
        data-aos-duration="3000"
        data-aos-delay="150">
      </div>
    </div>

    <ul
      class="mx-auto flex flex-col lg:flex-row text-left gap-3 items-start text-secondary mt-3">
      {
        features.map((template) => (
          <>
            <li class="flow-root col-span-full h-full ">
              <a href={template.url}>
                <div>
                  <p class="italic shrink-0 text-xs ">{template.title}</p>
                </div>
              </a>
            </li>
          </>
        ))
      }
    </ul>
  </div>
</section>
