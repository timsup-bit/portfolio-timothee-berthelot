<style is:global>
/* ────────────────────────────────────────────────────────────────
   Registre — portfolio de Timothée Berthelot
   Palette et typographie reprises de colletdigital.com :
   crème #f4f5ef, encre #161614, Geist. Traitement : document
   technique plutôt que vitrine. Monochrome, signaux fonctionnels
   réduits au strict nécessaire.
   ──────────────────────────────────────────────────────────────── */

:root {
  --ground:      #f4f5ef;
  --ground-sunk: #eceee4;
  --ink:         #161614;

  --ink-90: rgba(22, 22, 20, .90);
  --ink-70: rgba(22, 22, 20, .70);
  --ink-52: rgba(22, 22, 20, .52);
  --ink-38: rgba(22, 22, 20, .38);
  --rule:   rgba(22, 22, 20, .16);
  --rule-2: rgba(22, 22, 20, .08);
  --wash:   rgba(22, 22, 20, .035);

  --sig-live: #2f6b4f;
  --sig-wip:  #8a6a2f;
  --sig-done: rgba(22, 22, 20, .45);

  --sans: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

  --measure: 63ch;
  --pad: clamp(20px, 5vw, 76px);
  --rail: 168px;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --ground:      #131311;
    --ground-sunk: #191917;
    --ink:         #f4f5ef;

    --ink-90: rgba(244, 245, 239, .90);
    --ink-70: rgba(244, 245, 239, .68);
    --ink-52: rgba(244, 245, 239, .50);
    --ink-38: rgba(244, 245, 239, .36);
    --rule:   rgba(244, 245, 239, .18);
    --rule-2: rgba(244, 245, 239, .09);
    --wash:   rgba(244, 245, 239, .04);

    --sig-live: #6fae8c;
    --sig-wip:  #cfa860;
    --sig-done: rgba(244, 245, 239, .42);
  }
}

:root[data-theme="dark"] {
  --ground:      #131311;
  --ground-sunk: #191917;
  --ink:         #f4f5ef;

  --ink-90: rgba(244, 245, 239, .90);
  --ink-70: rgba(244, 245, 239, .68);
  --ink-52: rgba(244, 245, 239, .50);
  --ink-38: rgba(244, 245, 239, .36);
  --rule:   rgba(244, 245, 239, .18);
  --rule-2: rgba(244, 245, 239, .09);
  --wash:   rgba(244, 245, 239, .04);

  --sig-live: #6fae8c;
  --sig-wip:  #cfa860;
  --sig-done: rgba(244, 245, 239, .42);
}

.skip {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--ink);
  color: var(--ground);
  padding: 10px 16px;
  z-index: 50;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-decoration: none;
}
.skip:focus { left: 12px; top: 12px; }

*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--ground);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 17px;
  line-height: 1.62;
  font-weight: 380;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "kern" 1, "liga" 1;
}

::selection { background: var(--ink); color: var(--ground); }

a { color: inherit; }

:focus-visible {
  outline: 2px solid var(--ink);
  outline-offset: 3px;
  border-radius: 1px;
}

/* ── Ossature ─────────────────────────────────────────────────── */

.sheet {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 var(--pad);
}

.band { border-top: 1px solid var(--rule); }

.row {
  display: grid;
  grid-template-columns: var(--rail) minmax(0, 1fr);
  gap: clamp(20px, 4vw, 56px);
  padding: clamp(44px, 6vw, 86px) 0;
}

@media (max-width: 860px) {
  .row { grid-template-columns: minmax(0, 1fr); gap: 22px; }
}

/* ── Micro-typographie ────────────────────────────────────────── */

.mono {
  font-family: var(--mono);
  font-size: 11.5px;
  font-weight: 450;
  letter-spacing: .085em;
