  align-content: start;
}
.tryp-col:first-child { padding-left: 0; border-left: 0; }
.tryp-col:last-child { padding-right: 0; }

/* Repère sur l'axe : creux pour ce qui est passé ou à venir, plein pour maintenant */
.tryp-col::before {
  content: "";
  position: absolute;
  top: -5px;
  left: 0;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--ground);
  box-shadow: inset 0 0 0 1.5px var(--ink-38);
}
.tryp-col[data-now]::before {
  background: var(--ink);
  box-shadow: none;
}

.tryp-when { color: var(--ink-38); }

.tryp-tense {
  font-size: clamp(23px, 2.7vw, 32px);
  font-weight: 820;
  letter-spacing: -.024em;
  line-height: 1.02;
  margin: 0;
}

.tryp-lead {
  font-size: 15.5px;
  line-height: 1.5;
  color: var(--ink-90);
  margin: 0;
  max-width: 34ch;
}

.tryp-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
.tryp-list li {
  position: relative;
  padding-left: 16px;
  font-size: 14.5px;
  line-height: 1.45;
  color: var(--ink-70);
}
.tryp-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .64em;
  width: 8px;
  height: 1px;
  background: var(--ink-38);
}

@media (max-width: 860px) {
  .tryp { grid-template-columns: minmax(0, 1fr); border-top: 0; gap: 0; }
  .tryp-col {
    border-left: 0;
    border-top: 1px solid var(--rule);
    padding: 26px 0 30px;
